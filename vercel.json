{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/data",
      "destination": "/api/data"
    },
    {
      "source": "/api/refresh",
      "destination": "/api/refresh"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
